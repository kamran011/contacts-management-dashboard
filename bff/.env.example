# ─── BFF environment ──────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your mockapi.io project base URL.
# Example: https://65f0abc1234567890.mockapi.io/api/v1
#
# The `.env` file is gitignored — never commit real endpoints/secrets.
MOCKAPI_BASE_URL=

# Optional — port the GraphQL server listens on (defaults to 4000).
PORT=4000
