{
  "name": "bff",
  "version": "1.0.0",
  "description": "GraphQL Backend-for-Frontend — Apollo Server 4 + DataLoader over mockapi.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
